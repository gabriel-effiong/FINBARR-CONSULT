PORT=5000
NODE_ENV=development

# Copy the pooled Neon URL into DATABASE_URL and the direct Neon URL into DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.REGION.aws.neon.tech/DB?sslmode=require"

# Generate a long random value for JWT_SECRET. Set a unique admin username and password.
